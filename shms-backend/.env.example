# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/shms_db?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=changeme

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-string-at-least-256-bits
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Mail (for transfer/payment notifications) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- File storage ---
FILE_UPLOAD_DIR=./uploads

# --- Misc ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SHOW_SQL=false
DDL_AUTO=update
